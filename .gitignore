__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.png
!screenshots/*.png
!diff/figures/*.png
!uva_padova/figures/*.png
*.npz
.venv/
venv/
env/
.env

# Real-world datasets (not redistributable)
datasets/

# Generated simulator caches (built by cache_simulator.py; regenerate on demand)
*_cache/
*_cache.partial/
/cache/
/cache.partial/
*.b2nd
*.npy
*.tar.gz

# Paper sources stay local; only the built PDF is published
paper/*
!paper/main.pdf

# Private working notes (never shipped)
scratch/
*.private.md

# Simulator cache directories, both generations (cache_*_cf and the earlier
# cache_*). Each carries a meta.json recording the absolute path it was built
# at, so these must not be committed.
cache_*/
